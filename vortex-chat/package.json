{
  "name": "vortex-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "setup:spatial-assets": "powershell -ExecutionPolicy Bypass -File ..\\scripts\\setup_spatial_assets.ps1",
    "test": "node scripts/run-unit-tests.cjs",
    "test:smoke": "playwright test --config=playwright.config.ts --reporter=line",
    "test:integration": "playwright test --config=playwright.integration.config.ts --reporter=line",
    "test:spatial-smoke": "playwright test tests/spatial-smoke.spec.ts --config=playwright.config.ts --reporter=list"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "react-syntax-highlighter": "^16.1.0",
    "lucide-react": "^0.563.0",
    "framer-motion": "^12.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
