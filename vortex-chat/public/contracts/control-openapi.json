  "components": {
    "schemas": {
      "AllowlistRequest": {
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Domains"
          }
        },
        "type": "object",
        "title": "AllowlistRequest"
      },
      "AutonomyConfigRequest": {
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "reflection_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reflection Enabled"
          },
          "training_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Training Enabled"
          },
          "autoedit_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Autoedit Enabled"
          },
          "multi_agent_dialogue_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Multi Agent Dialogue Enabled"
          },
          "descriptive_reports_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Descriptive Reports Enabled"
          },
          "live_autoedit_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Live Autoedit Enabled"
          }
        },
        "type": "object",
        "title": "AutonomyConfigRequest"
      },
      "BootstrapRequest": {
        "properties": {
          "force": {
            "type": "boolean",
            "title": "Force",
            "default": false
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "ensure"
          }
        },
        "type": "object",
        "title": "BootstrapRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObsidianConfigRequest": {
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled"
          },
          "vault_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vault Path"
          }
        },
        "type": "object",
        "title": "ObsidianConfigRequest"
      },
      "TrainingResetRequest": {
        "properties": {
          "clear_runs": {
            "type": "boolean",
            "title": "Clear Runs",
            "default": true
          },
          "clear_learning_queue": {
            "type": "boolean",
            "title": "Clear Learning Queue",
            "default": true
          }
        },
        "type": "object",
        "title": "TrainingResetRequest"
      },
      "TrainingStartRequest": {
        "properties": {
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "quick"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "title": "TrainingStartRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
